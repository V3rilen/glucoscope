{
  "name": "glucoscope",
  "version": "0.1.0",
  "description": "Self-hosted, server-rendered blood glucose viewer with xDrip+ uploads and caregiver sharing",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
